# Copy to cds-service/.env. Same database as the Express server, but a plain
# libpq URL: no "?schema=public" suffix (psycopg2 rejects it).
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/ses_ehr"

# Optional overrides (defaults shown)
# CDS_LLM_MODEL="llama3.2:latest"
# OLLAMA_URL="http://127.0.0.1:11434"
# CDS_NUM_CTX=8192
# TESSERACT_CMD="C:\Program Files\Tesseract-OCR\tesseract.exe"
