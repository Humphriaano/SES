generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum HIVStatus {
  POSITIVE
  NEGATIVE
  UNKNOWN
}

enum EncounterStatus {
  OPEN
  CLOSED
}

enum BillingStatus {
  PENDING
  PAID
  WAIVED
}

model User {
  id              String    @id @default(uuid())
  name            String
  email           String    @unique
  password        String
  role            String?
  status          String    @default("active")

  // Profile
  firstName       String?
  surname         String?
  dateOfBirth     DateTime?
  sex             String?
  designation     String?

  // Contact
  nrc             String?
  hasNoNrc        Boolean   @default(false)
  address         String?
  countryCode     String?
  cellphone       String?

  // Auth
  username        String?   @unique
  rejectionReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  encounters              Encounter[]
  orderedInvestigations   InvestigationOrder[] @relation("OrderedInvestigations")
  vitalsRecorded          Vital[]              @relation("VitalsRecordedBy")
  queueStarted            QueueEntry[]         @relation("QueueStartedBy")
  priceUpdates            PriceListItem[]      @relation("PriceListUpdatedBy")
  priceChanges            PriceListChange[]    @relation("PriceListChangedBy")
  stockAdjustmentsPrepared StockAdjustment[] @relation("StockAdjustmentPreparedBy")
  stockAdjustmentsReviewed StockAdjustment[] @relation("StockAdjustmentReviewedBy")
}

model Patient {
  id          String    @id @default(uuid())
  firstName   String
  lastName    String
  dateOfBirth DateTime
  gender      Gender
  phone       String?
  address     String?
  nationalId  String?   @unique
  hivStatus   HIVStatus @default(UNKNOWN)
  hivTestDate DateTime?
  religion    String?
  createdAt   DateTime  @default(now())

  // Next of kin
  nextOfKinName         String?
  nextOfKinRelationship String?
  nextOfKinPhone        String?
  updatedAt   DateTime  @updatedAt

  // Patient portal
  email             String?
  preferredName     String?
  portalEnabled     Boolean   @default(false)
  emailOptedIn      Boolean   @default(true)
  portalLastSeenAt  DateTime?

  encounters            Encounter[]
  diagnoses             PatientDiagnosis[]
  medications           Medication[]
  vitals                Vital[]
  labResults            LabResult[]
  billingItems          BillingItem[]
  invoices              Invoice[]
  queues                Queue[]
  dispensings           Dispensing[]
  investigationOrders   InvestigationOrder[]
  queueEntries          QueueEntry[]
  appointments          Appointment[]
  portalSessions        PortalSession[]
  magicLinkTokens       MagicLinkToken[]
  pushSubscriptions     PushSubscription[]
  checkInEmails         PatientCheckInEmail[]
}

model Encounter {
  id             String          @id @default(uuid())
  patientId      String
  clinicianId    String
  status         EncounterStatus @default(OPEN)
  chiefComplaint String?
  hpi            String?
  examination    String?
  treatmentPlan  String?
  investigations String?
  notes          String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  patient   Patient @relation(fields: [patientId], references: [id])
  clinician User    @relation(fields: [clinicianId], references: [id])

  diagnoses             EncounterDiagnosis[]
  vitals                Vital[]
  labOrders             LabOrder[]
  prescriptions         Prescription[]
  billingItems          BillingItem[]
  investigationOrders   InvestigationOrder[]
}

model ICD11Code {
  id          String  @id @default(uuid())
  code        String  @unique
  description String
  category    String?
  isCustom    Boolean @default(false)   // added by staff rather than seeded from the ICD-11 list

  patientDiagnoses   PatientDiagnosis[]
  encounterDiagnoses EncounterDiagnosis[]
}

model PatientDiagnosis {
  id         String    @id @default(uuid())
  patientId  String
  icd11Id    String
  notes      String?
  diagnosedAt DateTime?  // when it was first diagnosed (year precision) — may be long before it was recorded here
  resolvedAt DateTime?
  createdAt  DateTime  @default(now())

  patient Patient   @relation(fields: [patientId], references: [id])
  icd11   ICD11Code @relation(fields: [icd11Id], references: [id])
}

model EncounterDiagnosis {
  id          String  @id @default(uuid())
  encounterId String
  icd11Id     String
  isPrimary   Boolean @default(false)
  notes       String?

  encounter Encounter @relation(fields: [encounterId], references: [id])
  icd11     ICD11Code @relation(fields: [icd11Id], references: [id])
}

model Vital {
  id                     String    @id @default(uuid())
  patientId              String
  encounterId            String?
  bloodPressureSystolic  Int?
  bloodPressureDiastolic Int?
  heartRate              Int?
  temperature            Float?
  weight                 Float?
  height                 Float?
  oxygenSat              Float?
  glucose                Float?
  recordedAt             DateTime  @default(now())
  recordedById           String?

  patient    Patient    @relation(fields: [patientId], references: [id])
  encounter  Encounter? @relation(fields: [encounterId], references: [id])
  recordedBy User?      @relation("VitalsRecordedBy", fields: [recordedById], references: [id])

  @@index([patientId, recordedAt])
}

model Medication {
  id        String    @id @default(uuid())
  patientId String
  name      String
  dosage    String?
  frequency String?
  route     String?
  duration      String?   // as typed by the prescriber, e.g. "5 days"
  catalogueCode String?   // drug catalogue SKU, so billing can find the price
    durationDays  Int?
    durationCount Int?
    durationUnit  String?
    unitsPerDose  Decimal?  @db.Decimal(10, 2)
    quantity      Decimal?  @db.Decimal(10, 2)
    quantityUnit  String?
    quantityManual Boolean @default(false)
    unitPrice      Decimal? @db.Decimal(12, 2)
    doseUnit       String?
    priceBasis     String?
    bottleSizeMl   Decimal? @db.Decimal(10, 2)
    courseQuantity Decimal? @db.Decimal(12, 2)
    billingQuantity Decimal? @db.Decimal(10, 2)
  startDate DateTime
  endDate   DateTime?
  notes     String?
  createdAt DateTime  @default(now())

  patient       Patient        @relation(fields: [patientId], references: [id])
  prescriptions Prescription[] @relation("PrescribedMedication")
  substitutePrescriptions Prescription[] @relation("SubstituteMedication")
}

model Prescription {
  id           String    @id @default(uuid())
  encounterId  String
  medicationId String
  substituteMedicationId String?
  preferredStockProductId String?
  dispensed    Boolean   @default(false)
  dispensedAt  DateTime?
  notAvailable Boolean   @default(false)   // pharmacy is out of it: the client buys elsewhere and is not charged
  createdAt    DateTime  @default(now())

  encounter   Encounter    @relation(fields: [encounterId], references: [id])
  medication  Medication   @relation("PrescribedMedication", fields: [medicationId], references: [id])
  substituteMedication Medication? @relation("SubstituteMedication", fields: [substituteMedicationId], references: [id], onDelete: SetNull)
  preferredStockProduct PharmacyProduct? @relation(fields: [preferredStockProductId], references: [id], onDelete: Restrict)
  dispensings Dispensing[]
  @@index([preferredStockProductId])
}

model Dispensing {
  id                 String    @id @default(uuid())
  prescriptionId     String?
  patientId          String
  type               String    @default("direct")
  dispensedDrug      String
  dispensedDose      String?
  dispensedFrequency String?
  dispensedDuration  String?
  quantity           Decimal? @db.Decimal(10, 2)
  unitPrice          Decimal? @db.Decimal(12, 2)
  catalogueCode      String?
  quantityUnit       String?
  priceBasis         String?
  billingQuantity    Decimal? @db.Decimal(10, 2)
  dispensedBy        String
  dispensedAt        DateTime  @default(now())
  substitution       Json?
  modifications      Json?
  collectedAt        DateTime?
  collectedBy        String?
  createdAt          DateTime  @default(now())

  prescription Prescription? @relation(fields: [prescriptionId], references: [id])
  patient      Patient       @relation(fields: [patientId], references: [id])
  stockAllocations StockDispensingAllocation[]
}

model DrugInventory {
  id        String   @id @default(uuid())
  drugName  String   @unique
  quantity  Int      @default(0)
  unit      String?
  updatedAt DateTime @updatedAt
}

// Ledger-managed catalogue items use batch allocations at dispensing. Items
// without a stock product retain the legacy counter during transition.
enum StockBatchStatus {
  USABLE
  QUARANTINED
}

enum StockMovementType {
  RECEIVED
  ISSUED
  LOSS
  ADJUSTMENT
  REVERSAL
}

model PharmacyProduct {
  id              String        @id @default(uuid())
  catalogueType   PriceItemType @default(DRUG)
  catalogueRef    String
  brand           String
  brandKey        String
  manufacturer    String?
  manufacturerKey String        @default("")
  baseUnit        String
  packSize        Decimal       @db.Decimal(18, 2)
  packLabel       String
  active          Boolean       @default(true)
  createdById     String
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  catalogueItem PriceListItem @relation(fields: [catalogueType, catalogueRef], references: [itemType, catalogueRef], onDelete: Restrict, onUpdate: Restrict)
  batches       StockBatch[]
  preferredPrescriptions Prescription[]

  @@unique([catalogueRef, brandKey, manufacturerKey, baseUnit, packSize], map: "PharmacyProduct_identity_key")
  @@index([catalogueRef, active])
}

model StockBatch {
  id          String           @id @default(uuid())
  productId   String
  lotNumber   String
  expiryDate  DateTime         @db.Date
  status      StockBatchStatus @default(USABLE)
  createdById String
  createdAt   DateTime         @default(now())

  product     PharmacyProduct @relation(fields: [productId], references: [id], onDelete: Restrict)
  movements   StockMovement[]
  receiptLines StockReceiptLine[]
  allocations StockDispensingAllocation[]
  adjustmentLines StockAdjustmentLine[]

  @@unique([productId, lotNumber])
  @@index([expiryDate, status])
}

// Retained in the database, so retries remain safe across process restarts.
model StockOperation {
  id          String   @id @default(uuid())
  actorId     String
  key         String
  kind        String
  requestHash String
  response    Json?
  createdAt   DateTime @default(now())
  movements   StockMovement[]
  receipts    StockReceipt[]
  submittedAdjustment StockAdjustment? @relation("AdjustmentSubmission")
  postedAdjustment StockAdjustment? @relation("AdjustmentPosting")

  @@unique([actorId, key])
}

model StockReceipt {
  id          String   @id @default(uuid())
  operationId String   @unique
  kind        String   @default("DELIVERY")
  receivedDate DateTime @db.Date
  reference   String
  source      String
  receivedById String
  createdAt   DateTime @default(now())
  operation StockOperation @relation(fields: [operationId], references: [id], onDelete: Restrict)
  lines StockReceiptLine[]
  @@index([receivedDate])
}

model StockReceiptLine {
  id          String  @id @default(uuid())
  receiptId   String
  batchId     String
  packCount   Decimal @db.Decimal(18, 2)
  packSize    Decimal @db.Decimal(18, 2)
  packLabel   String
  baseQuantity Decimal @db.Decimal(18, 2)
  baseUnit    String
  costPerPack Decimal? @db.Decimal(18, 2)
  receipt StockReceipt @relation(fields: [receiptId], references: [id], onDelete: Restrict)
  batch StockBatch @relation(fields: [batchId], references: [id], onDelete: Restrict)
  movement StockMovement?
  @@unique([receiptId, batchId])
}

model StockMovement {
  id          String            @id @default(uuid())
  postingOrder BigInt           @unique @default(autoincrement())
  operationId String
  batchId     String
  type        StockMovementType
  quantity    Decimal           @db.Decimal(18, 2)
  baseUnit    String
  reference   String
  reason      String?
  actorId     String
  approvedById String?
  receiptLineId String?         @unique
  reversalOfId String?          @unique
  createdAt   DateTime          @default(now())

  operation StockOperation @relation(fields: [operationId], references: [id], onDelete: Restrict)
  batch StockBatch @relation(fields: [batchId], references: [id], onDelete: Restrict)
  receiptLine StockReceiptLine? @relation(fields: [receiptLineId], references: [id], onDelete: Restrict)
  reversalOf StockMovement? @relation("StockReversal", fields: [reversalOfId], references: [id], onDelete: Restrict)
  reversal StockMovement? @relation("StockReversal")
  allocation StockDispensingAllocation?
  adjustmentLine StockAdjustmentLine?
  @@index([batchId, createdAt, id])
  @@index([batchId, postingOrder])
}

// Posted atomically with dispensing and its billing changes. One dispensing
// can span eligible batches and products of the same clinical item and unit.
model StockDispensingAllocation {
  id           String  @id @default(uuid())
  dispensingId String
  batchId      String
  movementId   String  @unique
  quantity     Decimal @db.Decimal(18, 2)
  baseUnit     String
  dispensing Dispensing @relation(fields: [dispensingId], references: [id], onDelete: Restrict)
  batch StockBatch @relation(fields: [batchId], references: [id], onDelete: Restrict)
  movement StockMovement @relation(fields: [movementId], references: [id], onDelete: Restrict)
  @@unique([dispensingId, batchId])
}

model StockAdjustment {
  id                   String @id @default(uuid())
  kind                 String
  status               String @default("PENDING")
  reference            String
  reasonCode           String
  reason               String?
  preparedById         String
  preparedAt           DateTime @default(now())
  reviewedById         String?
  reviewedAt           DateTime?
  reviewNote           String?
  submittedOperationId String @unique
  postedOperationId    String? @unique
  preparedBy User @relation("StockAdjustmentPreparedBy", fields: [preparedById], references: [id], onDelete: Restrict)
  reviewedBy User? @relation("StockAdjustmentReviewedBy", fields: [reviewedById], references: [id], onDelete: Restrict)
  submittedOperation StockOperation @relation("AdjustmentSubmission", fields: [submittedOperationId], references: [id], onDelete: Restrict)
  postedOperation StockOperation? @relation("AdjustmentPosting", fields: [postedOperationId], references: [id], onDelete: Restrict)
  lines StockAdjustmentLine[]
  @@index([status, preparedAt])
}

model StockAdjustmentLine {
  id                   String @id @default(uuid())
  adjustmentId         String
  batchId              String
  baseUnit             String
  expectedQuantity     Decimal @db.Decimal(18, 2)
  expectedPostingOrder BigInt
  countedQuantity      Decimal? @db.Decimal(18, 2)
  changeQuantity       Decimal @db.Decimal(18, 2)
  movementId           String? @unique
  adjustment StockAdjustment @relation(fields: [adjustmentId], references: [id], onDelete: Restrict)
  batch StockBatch @relation(fields: [batchId], references: [id], onDelete: Restrict)
  movement StockMovement? @relation(fields: [movementId], references: [id], onDelete: Restrict)
  @@unique([adjustmentId, batchId])
}

model LabOrder {
  id          String   @id @default(uuid())
  encounterId String
  testName    String
  notes       String?
  orderedAt   DateTime @default(now())
  status      String   @default("pending")

  encounter Encounter   @relation(fields: [encounterId], references: [id])
  results   LabResult[]
}

model LabResult {
  id             String   @id @default(uuid())
  patientId      String
  labOrderId     String?
  testName       String
  result         String
  unit           String?
  referenceRange String?
  isAbnormal     Boolean  @default(false)
  recordedAt     DateTime @default(now())

  patient  Patient   @relation(fields: [patientId], references: [id])
  labOrder LabOrder? @relation(fields: [labOrderId], references: [id])
}

enum QueueStatus {
  WAITING
  CALLED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ServicePoint {
  REGISTRY
  VITALS
  CONSULTATION
  PHARMACY
  LAB
  BILLING
}

model Queue {
  id           String       @id @default(uuid())
  patientId    String
  servicePoint ServicePoint
  status       QueueStatus  @default(WAITING)
  priority     Int          @default(0)
  notes        String?
  addedAt      DateTime     @default(now())
  calledAt     DateTime?
  completedAt  DateTime?

  patient Patient @relation(fields: [patientId], references: [id])
}

model BillingItem {
  id          String        @id @default(uuid())
  patientId   String
  encounterId String?
  description String
  amount      Float
  status      BillingStatus @default(PENDING)
  paidAt      DateTime?
  createdAt   DateTime      @default(now())

  patient   Patient    @relation(fields: [patientId], references: [id])
  encounter Encounter? @relation(fields: [encounterId], references: [id])
}

model InvestigationOrder {
  id          String   @id @default(uuid())
  patientId   String
  encounterId String?
  orderedById String
  orderedAt   DateTime @default(now())

  patient   Patient    @relation(fields: [patientId], references: [id])
  encounter Encounter? @relation(fields: [encounterId], references: [id])
  orderedBy User       @relation("OrderedInvestigations", fields: [orderedById], references: [id])
  items     InvestigationOrderItem[]
}

model InvestigationOrderItem {
  id                 String    @id @default(uuid())
  orderId            String
  type               String
  catalogueId        String
  name               String
  specimen           String?
  status             String    @default("Pending")
  componentsJson     String?
  sampleReceivedAt   DateTime?
  sampleReceivedById String?

  order   InvestigationOrder  @relation(fields: [orderId], references: [id])
  results InvestigationResult[]
}

model InvestigationResult {
  id           String   @id @default(uuid())
  itemId       String
  resultedById String
  resultedAt   DateTime @default(now())
  amendedById  String?
  amendedAt    DateTime?
  resultsJson  String

  item InvestigationOrderItem @relation(fields: [itemId], references: [id])
}

// ── Facility Rooms & Queue Entries ────────────────────────────────────────────

model FacilityRoom {
  id        String      @id @default(uuid())
  name      String      @unique
  tag       String
  active    Boolean     @default(true)
  createdAt DateTime    @default(now())

  entries     QueueEntry[]
  preferences UserRoomPreference[]
}

model UserRoomPreference {
  id        String   @id @default(uuid())
  userId    String
  roomId    String
  pickCount Int      @default(1)
  updatedAt DateTime @updatedAt

  room FacilityRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@unique([userId, roomId])
}

model QueueEntry {
  id          String       @id @default(uuid())
  queueNumber Int
  patientId   String
  patientName String
  roomId      String
  priority    String       @default("Normal")
  status      String       @default("Waiting")
  checkedInAt DateTime     @default(now())
  startedAt   DateTime?    // when the patient started being seen — waiting time stops here
  startedById String?      // the staff member seeing them
  updatedAt   DateTime     @updatedAt

  patient   Patient      @relation(fields: [patientId], references: [id])
  room      FacilityRoom @relation(fields: [roomId], references: [id])
  startedBy User?        @relation("QueueStartedBy", fields: [startedById], references: [id])

  @@index([roomId, status, checkedInAt])
  @@index([checkedInAt])
}

// ── Patient Portal ────────────────────────────────────────────────────────────

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum ConfirmationChannel {
  EMAIL
  PORTAL
}

model Appointment {
  id             String               @id @default(uuid())
  patientId      String
  clinicianName  String?
  clinicName     String               @default("SES Clinic")
  scheduledAt    DateTime
  status         AppointmentStatus    @default(SCHEDULED)
  confirmedAt    DateTime?
  confirmedVia   ConfirmationChannel?
  reminderSentAt DateTime?
  notes          String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  patient Patient @relation(fields: [patientId], references: [id])

  @@index([patientId, scheduledAt])
}

// Single-use portal sign-in tokens (magic links). Raw token is emailed; only
// its SHA-256 hash is stored.
model MagicLinkToken {
  id        String    @id @default(uuid())
  patientId String
  tokenHash String    @unique
  purpose   String    @default("login") // login | invitation
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  patient Patient @relation(fields: [patientId], references: [id])
}

// Server-side portal sessions. Cookie carries the raw session token; only its
// SHA-256 hash is stored. 30-day sliding expiry.
model PortalSession {
  id         String    @id @default(uuid())
  patientId  String
  tokenHash  String    @unique
  createdAt  DateTime  @default(now())
  expiresAt  DateTime
  lastSeenAt DateTime  @default(now())
  userAgent  String?
  revokedAt  DateTime?

  patient Patient @relation(fields: [patientId], references: [id])

  @@index([patientId])
}

model AuthAuditLog {
  id        String   @id @default(uuid())
  patientId String?
  email     String?
  event     String // LINK_REQUESTED | LINK_SENT | LOGIN_SUCCESS | LOGIN_FAILED | LOGOUT
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([patientId, createdAt])
}

// Endpoint-level access audit: which patient fetched what, when.
model PortalAccessLog {
  id        String   @id @default(uuid())
  patientId String
  method    String
  endpoint  String
  createdAt DateTime @default(now())

  @@index([patientId, createdAt])
}

model PushSubscription {
  id        String   @id @default(uuid())
  patientId String
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())

  patient Patient @relation(fields: [patientId], references: [id])

  @@index([patientId])
}

// Plain-language education content matched to conditions (tips + myth-busters),
// shared by the monthly check-in email and the portal Conditions screen.
model ConditionContent {
  id               String @id @default(uuid())
  conditionKey     String @unique // e.g. "hypertension"
  icdPrefixes      String // comma-separated ICD-11 code prefixes to match
  matchTerms       String // comma-separated diagnosis-description terms to match
  plainName        String
  plainDescription String
  tips             Json // string[]
  mythBusters      Json // { myth: string; truth: string }[]
}

// Log of monthly check-in emails with the full data snapshot used to render
// them, so past check-ins can be re-viewed in the portal.
model PatientCheckInEmail {
  id           String   @id @default(uuid())
  patientId    String
  subject      String
  dataSnapshot Json
  sentAt       DateTime @default(now())

  patient Patient @relation(fields: [patientId], references: [id])

  @@index([patientId, sentAt])
}


// ── Billing: price list ──────────────────────────────────────────────────────
// The single source of truth for default prices. Charge lines copy ("snapshot") the price when they are
// created, so editing a price here never rewrites an existing invoice.

enum PriceItemType {
  DRUG
  INVESTIGATION
  PROCEDURE
  CONSULTATION
  OTHER
}

model PriceListItem {
  id            String        @id @default(uuid())
  itemType      PriceItemType
  catalogueRef  String        // drug stock code, investigation key (e.g. single_31), or a generated code for manual items
  name          String
  detail        String?       // dose · form · route, or specimen
  unit          String        @default("each")   // what one price covers: each, per course, per pack, per test…
  bottleSizeMl  Decimal?      @db.Decimal(10, 2)
  unitPrice     Decimal?      @db.Decimal(12, 2) // null = not priced yet
  active        Boolean       @default(true)
  effectiveFrom DateTime?     // when the current price took effect
  updatedById   String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  updatedBy User?             @relation("PriceListUpdatedBy", fields: [updatedById], references: [id])
  changes   PriceListChange[]
  pharmacyProducts PharmacyProduct[]

  @@unique([itemType, catalogueRef])
  @@index([itemType, name])
}

model PriceListChange {
  id          String   @id @default(uuid())
  itemId      String
  field       String   // price | active | unit | name
  oldValue    String?
  newValue    String?
  changedById String?
  changedAt   DateTime @default(now())

  item      PriceListItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  changedBy User?         @relation("PriceListChangedBy", fields: [changedById], references: [id])

  @@index([itemId, changedAt])
}

// Drugs added by staff, on top of the built-in ZAMMSA drug catalogue.
model CatalogueDrug {
  id           String   @id @default(uuid())
  code         String   @unique            // "CUS0001" style, also the price-list key
  generic      String                      // generic (INN) name — what the built-in catalogue calls "name"
  brand        String?
  strength     String                      // e.g. "500mg"
  form         String                      // Tablet, Syrup, Injection …
  route        String                      // Oral, IV …
  atcCode      String?
  manufacturer String?
  ingredients  Json?
  pendingReview Boolean @default(false)
  active       Boolean  @default(true)
  createdById  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([generic])
}

// Tests added by staff. A SINGLE is one measured result; a PANEL groups SINGLE tests (built-in or added).
model CatalogueTest {
  id            String   @id @default(uuid())
  seq           Int      @unique @default(autoincrement())   // public id = 100000 + seq, clear of the built-in ids
  kind          String                                       // SINGLE | PANEL
  name          String
  abbr          String?
  loinc         String?
  specimen      String
  subType       String?                                      // department / section
  dataType      String   @default("float")                   // float | integer | enum | free text | date
  units         String?
  referenceRange String?
  options       Json?                                        // string[] for enum results
  searchNames   Json?                                        // string[] of synonyms (panels)
  componentIds  Json?                                        // number[] of SINGLE test ids (panels)
  active        Boolean  @default(true)
  createdById   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([kind, name])
}

// ── Billing ──────────────────────────────────────────────────────────────────
enum InvoiceStatus {
  OPEN
  PART_PAID
  PAID
  VOID
  WAIVED
}
enum ChargeSource {
  CONSULTATION
  PRESCRIPTION
  INVESTIGATION
  PROCEDURE
  MANUAL
}

// One row per numbering series and year ("INV-2026"). Incremented inside the same transaction that
// creates the document, so a failed save rolls the number back and the series has no gaps.
model DocumentCounter {
  name      String @id
  lastValue Int    @default(0)
}

model Invoice {
  id           String        @id @default(uuid())
  number       String        @unique              // INV-2026-000001, never reused; voided invoices stay on record
  patientId    String
  payer        String        @default("CASH")
  status       InvoiceStatus @default(OPEN)
  emergency    Boolean       @default(false)       // patient was in the Emergency queue: billing follows care
  dueDate      DateTime?
  lockedAt     DateTime?
  voidedAt     DateTime?
  voidReason   String?
  voidedById   String?
  discountAmount   Decimal    @db.Decimal(12, 2) @default(0)   // in ZMW, taken off the total; the original total stays visible
  discountReason   String?
  discountById     String?                                     // approver
  waivedAt         DateTime?
  waivedReason     String?
  waivedById       String?
  releasedAt       DateTime?                                   // allowed to leave with a balance
  releasedById     String?
  releaseReason    String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  patient  Patient      @relation(fields: [patientId], references: [id])
  lines    ChargeLine[]
  payments Payment[]

  @@index([patientId, status])
  @@index([createdAt])
}

model ChargeLine {
  id          String       @id @default(uuid())
  invoiceId   String
  patientId   String
  encounterId String?
  sourceType  ChargeSource
  sourceId    String?                              // prescription / investigation item / "patientId:date" for the fee
  description String
  detail      String?
  quantity    Decimal      @db.Decimal(10, 2) @default(1)
  unitPrice   Decimal?     @db.Decimal(12, 2)      // snapshot of the price list at the moment of ordering; null = not priced yet
  priceItemId String?
  status      String       @default("ACTIVE")      // ACTIVE | VOIDED
  auto        Boolean      @default(true)          // false = added by hand at the billing desk
  needsReview Boolean      @default(false)         // quantity or price could not be worked out automatically
  quantityUnsure Boolean   @default(false)         // the quantity is a placeholder until the billing desk confirms it
  createdById String?
  voidedAt    DateTime?
  voidReason  String?
  createdAt   DateTime     @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id])

  @@unique([sourceType, sourceId])
  @@index([invoiceId])
  @@index([patientId])
}

model Payment {
  id            String   @id @default(uuid())
  receiptNumber String   @unique                   // RCT-2026-000001; a voided receipt stays on record
  invoiceId     String
  amount        Decimal  @db.Decimal(12, 2)
  method        String                             // CASH | MOBILE_MONEY | CARD | CREDIT
  reference     String?                            // mobile money / card reference
  payerName     String?                            // who actually paid (parent, relative …)
  payerPhone    String?
  receivedById  String
  sessionId     String?
  status        String   @default("ACTIVE")        // ACTIVE | VOID
  voidedAt      DateTime?
  voidReason    String?
  voidedById    String?
  createdAt     DateTime @default(now())

  invoice Invoice       @relation(fields: [invoiceId], references: [id])
  session CashierSession? @relation(fields: [sessionId], references: [id])

  @@index([invoiceId])
  @@index([createdAt])
  @@index([receivedById, createdAt])
}

// Money held on account for a patient. Positive = credit given (overpayment), negative = credit used.
model PatientCredit {
  id          String   @id @default(uuid())
  patientId   String
  amount      Decimal  @db.Decimal(12, 2)
  kind        String                               // SURPLUS | APPLIED
  reason      String
  invoiceId   String?
  paymentId   String?
  createdById String?
  createdAt   DateTime @default(now())

  @@index([patientId])
  @@index([invoiceId])
}

// Every billing-side alteration: who, when, before and after. Normal clinical work is not logged here.
model BillingAudit {
  id           String   @id @default(uuid())
  at           DateTime @default(now())
  userId       String?
  action       String
  entity       String
  entityId     String?
  invoiceId    String?
  patientId    String?
  before       Json?
  after        Json?
  reason       String?
  approvedById String?

  @@index([invoiceId])
  @@index([patientId])
  @@index([at])
}

model CashierSession {
  id           String    @id @default(uuid())
  userId       String
  openedAt     DateTime  @default(now())
  openingFloat Decimal   @db.Decimal(12, 2) @default(0)
  closedAt     DateTime?
  expectedCash Decimal?  @db.Decimal(12, 2)
  countedCash  Decimal?  @db.Decimal(12, 2)
  note         String?

  payments Payment[]

  @@index([userId, closedAt])
  @@index([openedAt])
}

// A procedure recorded during an encounter (cannulation, suturing, ...). Billed through a PROCEDURE charge line
// whose sourceId is this row's id. Taking one back off the note is a status change, never a delete.
model EncounterProcedure {
  id            String    @id @default(uuid())
  encounterId   String
  patientId     String
  clientId      String                          // the note block item's own id, so a retry never records it twice
  catalogueRef  String?                         // PROCEDURE price-list reference; null when typed in by hand (no charge)
  name          String
  site          String?
  note          String?
  performedById String
  performedAt   DateTime  @default(now())
  status        String    @default("ACTIVE")    // ACTIVE | REMOVED
  removedAt     DateTime?
  removedById   String?
  removeReason  String?
  createdAt     DateTime  @default(now())

  @@unique([encounterId, clientId])
  @@index([patientId, performedAt])
}
