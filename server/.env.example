# Copy to server/.env and fill in. Never commit the real file.

# PostgreSQL (the default install port is 5432)
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/ses_ehr"

# Signs staff login tokens. Required; the server will not start without it.
# Generate one:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=""

PORT=5000
CLIENT_URL="http://localhost:5173"
PORTAL_URL="http://localhost:5175"
# CDS_URL="http://localhost:8000"

# --- Optional features -------------------------------------------------------
# Patient-portal push notifications. Generate:  npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:you@example.com"

# Patient-portal email (Brevo). Leave empty to disable.
BREVO_API_KEY=""
EMAIL_FROM_ADDRESS=""
EMAIL_FROM_NAME="SES Health"

# WHO ICD-11 API, only used to refresh diagnosis codes online. Leave empty to
# use the bundled list in server/data.
WHO_ICD11_CLIENT_ID=""
WHO_ICD11_CLIENT_SECRET=""
